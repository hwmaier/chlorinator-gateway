[Unit]
Description=MQTT Gateway for Astral Pool chlorinators
After=network.target

[Service]
ExecStart=/usr/bin/python3 /home/admin/chlorinator-gateway
WorkingDirectory=/home/admin/chlorinator-gateway/
StandardOutput=inherit
StandardError=inherit
Restart=always
User=admin # Adjust to the user

[Install]
WantedBy=multi-user.target
