[Unit]
Description=MQTT Gateway for Astral Pool chlorinators
After=network.target

[Service]
ExecStart=/usr/bin/python3 -u /home/admin/chlorinator-gateway/ble2mqtt.py
WorkingDirectory=/home/admin/chlorinator-gateway/
StandardOutput=journal
StandardError=journal
Restart=always
User=admin

[Install]
WantedBy=multi-user.target
